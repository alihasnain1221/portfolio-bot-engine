# Copy to `.env` and fill in ONE (or more) keys. Ingestion auto-detects
# whichever is present; preference order: anthropic > openai > groq > xai > gemini.
# Override with PORTFOLIO_LLM_PROVIDER / PORTFOLIO_LLM_MODEL.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Google AI Studio key (aistudio.google.com/api-keys). Free tier content may be
# used by Google to improve its products.
GEMINI_API_KEY=

# PORTFOLIO_LLM_PROVIDER=anthropic
# PORTFOLIO_LLM_MODEL=claude-opus-5-5
# Overrides per-call effort. Claude: low|medium|high|xhigh|max. Gemini: minimal|low|medium|high.
# PORTFOLIO_LLM_EFFORT=low

# --- Serving guardrails (optional) ---
# Lock CORS to your site in prod (comma-separated). Default "*".
# PORTFOLIO_ALLOWED_ORIGINS=https://your-portfolio.com
# PORTFOLIO_RATE_LIMIT=20
# PORTFOLIO_RATE_WINDOW_SEC=300
# PORTFOLIO_MAX_QUESTION_LEN=600

# Cloudflare Turnstile SECRET key (bot protection for /ask). When set, /ask
# requires a valid turnstile_token from the frontend; leave empty to disable
# (dev). Pair with VITE_TURNSTILE_SITE_KEY on the frontend. Both come from the
# Cloudflare dashboard: Turnstile -> Add site.
PORTFOLIO_TURNSTILE_SECRET=
